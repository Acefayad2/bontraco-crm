STRIPE_SECRET_KEY=replace-in-netlify-secret-store
STRIPE_WEBHOOK_SECRET=replace-in-netlify-secret-store
STRIPE_PRICE_STARTER=price_replace
STRIPE_PRICE_GROWTH=price_replace
STRIPE_PRICE_PRO=price_replace
RETELL_API_KEY=replace-in-netlify-secret-store
RETELL_AGENT_ID=replace-in-netlify-secret-store
RETELL_FROM_NUMBER=+13125550100
OPERATIONS_ALERT_WEBHOOK_URL=https://your-on-call-webhook.example/bontraco

# Keep false until an operator has tested backups, exports, and provider cleanup.
ACCOUNT_PURGE_ENABLED=false
