{
  "name": "bontraco-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run audit:artifact",
    "build:production-artifact": "VITE_DEMO_MODE=false tsc -b && VITE_DEMO_MODE=false vite build",
    "audit:artifact": "node scripts/build-artifact-audit.mjs",
    "audit:migrations": "node scripts/migration-audit.mjs",
    "audit:repository-secrets": "node scripts/repository-secret-audit.mjs",
    "audit:runtime": "npm audit --omit=dev",
    "audit:sql-suites": "node scripts/sql-suite-audit.mjs",
    "preflight:production": "node scripts/release-preflight.mjs",
    "smoke:roles": "node scripts/role-smoke-verify.mjs",
    "smoke:roles:full": "node scripts/role-smoke-run.mjs",
    "verify:restore": "node scripts/backup-restore-verify.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:browser:auth": "node scripts/browser-smoke.mjs --auth-gate",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run test && npm run build",
    "verify:production-artifact": "npm run build:production-artifact && CONTEXT=production npm run audit:artifact",
    "verify:release": "npm run verify && npm run audit:repository-secrets && npm run audit:migrations && npm run audit:sql-suites && npm run verify:production-artifact && npm run audit:runtime",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.116.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "retell-sdk": "^5.66.1",
    "stripe": "^22.6.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.3.0",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
